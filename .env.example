# Скопируйте в .env и заполните: cp .env.example .env  (.env в git не попадает)
# Для `python -m bot --dry-run` Telegram не нужен.
# Без GEMINI_API_KEY посты будут с оригинальным английским текстом.

# Токен от @BotFather, вида 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# @username публичного канала или числовой id вида -1001234567890
TELEGRAM_CHAT_ID=

# Ключ из Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Необязательно: цепочка моделей через запятую, по умолчанию gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL=

# Необязательно: повышает лимит запросов к api.github.com (нужен только для type: github_releases)
GITHUB_TOKEN=
